// part: metadata

[setup]
drop = "test_interval_year_to_month"

[tags]
sql-type-name = "INTERVAL YEAR TO MONTH"

// part: setup_query

CREATE TABLE test_interval_year_to_month AS
SELECT idx, CAST(res AS INTERVAL YEAR TO MONTH) AS res
FROM (VALUES
    (1, INTERVAL '3' MONTH),
    (2, INTERVAL '2' YEAR),
    (3, INTERVAL '2-6' YEAR TO MONTH),
    (4, INTERVAL '0-0' YEAR TO MONTH),
    (5, NULL)
) AS intervals(idx, res)

// part: query

SELECT res FROM test_interval_year_to_month ORDER BY idx

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "tin",
            "flags": ["nullable"]
        }
    ]
}

// part: expected

{"res": "3M0d0ns"}
{"res": "24M0d0ns"}
{"res": "30M0d0ns"}
{"res": "0M0d0ns"}
{"res": null}
