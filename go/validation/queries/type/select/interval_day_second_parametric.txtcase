// part: metadata

[setup]
drop = "test_interval_day_second_parametric"

[tags]
sql-type-name = "INTERVAL DAY TO SECOND"

// part: setup_query

CREATE TABLE test_interval_day_second_parametric AS
SELECT
    1 AS idx,
    INTERVAL '123' DAY(3) AS day_only,
    INTERVAL '123 01' DAY(3) TO HOUR AS day_hour,
    INTERVAL '123 01:02' DAY(3) TO MINUTE AS day_minute,
    INTERVAL '1 00:00:01' DAY(2) TO SECOND(0) AS day_second0,
    INTERVAL '1 00:00:00.123456' DAY(2) TO SECOND(6) AS day_second6,
    INTERVAL '1 00:00:00.123456789' DAY(2) TO SECOND(9) AS day_second9,
    INTERVAL '1 00:00:00.123456789999' DAY(2) TO SECOND(12) AS day_second12,
    INTERVAL '123' HOUR(3) AS hour_only,
    INTERVAL '123:04' HOUR(3) TO MINUTE AS hour_minute,
    INTERVAL '123:04:05.123456' HOUR(3) TO SECOND(6) AS hour_second,
    INTERVAL '123' MINUTE(3) AS minute_only,
    INTERVAL '123:04.123456' MINUTE(3) TO SECOND(6) AS minute_second,
    INTERVAL '123' SECOND(3, 0) AS second0,
    INTERVAL '123.123456789999' SECOND(3, 12) AS second12
UNION ALL
SELECT 2, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL

// part: query

SELECT day_only, day_hour, day_minute, day_second0, day_second6, day_second9, day_second12, hour_only, hour_minute, hour_second, minute_only, minute_second, second0, second12
FROM test_interval_day_second_parametric ORDER BY idx

