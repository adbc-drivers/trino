// part: metadata

[setup]
drop = "test_interval_year_month_parametric"

[tags]
sql-type-name = "INTERVAL YEAR TO MONTH"

// part: setup_query

CREATE TABLE test_interval_year_month_parametric AS
SELECT
    1 AS idx,
    INTERVAL '123-4' YEAR(3) TO MONTH AS year_month,
    INTERVAL '123' YEAR(3) AS year_only,
    INTERVAL '123' MONTH(3) AS month_only
UNION ALL
SELECT 2, NULL, NULL, NULL

// part: query

SELECT year_month, year_only, month_only
FROM test_interval_year_month_parametric ORDER BY idx

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "year_month",
            "format": "tin",
            "flags": ["nullable"]
        },
        {
            "name": "year_only",
            "format": "tin",
            "flags": ["nullable"]
        },
        {
            "name": "month_only",
            "format": "tin",
            "flags": ["nullable"]
        }
    ]
}

// part: expected

{"year_month":"1480M0d0ns","year_only":"1476M0d0ns","month_only":"123M0d0ns"}
{"year_month":null,"year_only":null,"month_only":null}
