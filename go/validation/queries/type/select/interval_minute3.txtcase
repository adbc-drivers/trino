// part: metadata

[setup]
drop = "test_interval_minute3"

[tags]
sql-type-name = "INTERVAL MINUTE(3)"

// part: setup_query

CREATE TABLE test_interval_minute3 AS
SELECT 1 AS idx, INTERVAL '123' MINUTE(3) AS res
UNION ALL
SELECT 2, NULL

// part: query

SELECT res FROM test_interval_minute3 ORDER BY idx

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "tin",
            "flags": ["nullable"]
        }
    ]
}

// part: expected

{"res": "0M0d7380000000000ns"}
{"res": null}
