// part: metadata

[setup]
drop = "test_interval_day_to_second"

[tags]
sql-type-name = "INTERVAL DAY TO SECOND"

// part: setup_query

CREATE TABLE test_interval_day_to_second AS
SELECT idx, CAST(res AS INTERVAL DAY TO SECOND) AS res
FROM (VALUES
    (1, INTERVAL '2' DAY),
    (2, INTERVAL '1' HOUR),
    (3, INTERVAL '30' MINUTE),
    (4, INTERVAL '45.123' SECOND),
    (5, INTERVAL '1 23:59:59.999' DAY TO SECOND),
    (6, NULL)
) AS intervals(idx, res)

// part: query

SELECT res FROM test_interval_day_to_second ORDER BY idx

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "tin",
            "flags": ["nullable"]
        }
    ]
}

// part: expected

{"res": "0M2d0ns"}
{"res": "0M0d3600000000000ns"}
{"res": "0M0d1800000000000ns"}
{"res": "0M0d45123000000ns"}
{"res": "0M1d86399999000000ns"}
{"res": null}
