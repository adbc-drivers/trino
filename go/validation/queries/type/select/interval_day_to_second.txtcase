// part: metadata

[setup]
drop = "test_interval_day_to_second"

[tags]
sql-type-name = "INTERVAL DAY TO SECOND"

// part: setup_query

CREATE TABLE test_interval_day_to_second AS
SELECT
    idx,
    CAST(res AS INTERVAL DAY TO SECOND) AS res,
    CASE WHEN idx = 1 THEN INTERVAL '123' DAY(3) END AS day_only,
    CASE WHEN idx = 1 THEN INTERVAL '123 01' DAY(3) TO HOUR END AS day_hour,
    CASE WHEN idx = 1 THEN INTERVAL '123 01:02' DAY(3) TO MINUTE END AS day_minute,
    CASE WHEN idx = 1 THEN INTERVAL '1 00:00:01' DAY(2) TO SECOND(0) END AS day_second0,
    CASE WHEN idx = 1 THEN INTERVAL '1 00:00:00.123456' DAY(2) TO SECOND(6) END AS day_second6,
    CASE WHEN idx = 1 THEN INTERVAL '1 00:00:00.123456789' DAY(2) TO SECOND(9) END AS day_second9,
    CASE WHEN idx = 1 THEN INTERVAL '1 00:00:00.123456789999' DAY(2) TO SECOND(12) END AS day_second12,
    CASE WHEN idx = 1 THEN INTERVAL '123' HOUR(3) END AS hour_only,
    CASE WHEN idx = 1 THEN INTERVAL '123:04' HOUR(3) TO MINUTE END AS hour_minute,
    CASE WHEN idx = 1 THEN INTERVAL '123:04:05.123456' HOUR(3) TO SECOND(6) END AS hour_second,
    CASE WHEN idx = 1 THEN INTERVAL '123' MINUTE(3) END AS minute_only,
    CASE WHEN idx = 1 THEN INTERVAL '123:04.123456' MINUTE(3) TO SECOND(6) END AS minute_second,
    CASE WHEN idx = 1 THEN INTERVAL '123' SECOND(3, 0) END AS second0,
    CASE WHEN idx = 1 THEN INTERVAL '123.123456789999' SECOND(3, 12) END AS second12
FROM (VALUES
    (1, INTERVAL '2' DAY),
    (2, INTERVAL '1' HOUR),
    (3, INTERVAL '30' MINUTE),
    (4, INTERVAL '45.123' SECOND),
    (5, INTERVAL '1 23:59:59.999' DAY TO SECOND),
    (6, NULL)
) AS intervals(idx, res)

// part: query

SELECT res, day_only, day_hour, day_minute, day_second0, day_second6, day_second9, day_second12, hour_only, hour_minute, hour_second, minute_only, minute_second, second0, second12
FROM test_interval_day_to_second ORDER BY idx

